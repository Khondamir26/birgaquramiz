# Backend
PORT=5000

# Observability — get DSN from sentry.io (leave blank to disable)
SENTRY_DSN=
DATABASE_URL=postgresql://birga_app@localhost:5432/birga_prod
JWT_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=http://{domain_of_your_frontend}
BCRYPT_SALT_ROUNDS=number_of_salt_rounds_for_bcrypt

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Maps Platform — used by MapsModule (geocoding, routes, ETA, road snap)
# Enable: Maps JavaScript API, Routes API, Geocoding API, Roads API, Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend URL for WebSocket CORS
FRONTEND_URL=http://localhost:3000

# Background removal via remove.bg (https://www.remove.bg/api)
# Get a free API key at https://www.remove.bg/api#api-changelog
# Leave empty to skip background removal and keep original uploaded images
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Google Gemini API — used by AiModule (/ai/chat endpoint)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram — bot token used for auth signature verification and order notifications
# Bot username is exposed to the frontend as NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Cloudflare R2 — used for file uploads
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your_bucket_name
R2_PUBLIC_URL=https://your-r2-public-url.com

# Eskiz SMS — OTP delivery confirmations (https://eskiz.uz)
ESKIZ_EMAIL=your_eskiz_email_here
ESKIZ_PASSWORD=your_eskiz_password_here

# Payments
PAYME_MERCHANT_KEY=your_payme_merchant_key_here
CLICK_SECRET_KEY=your_click_secret_key_here
CLICK_SERVICE_ID=your_click_service_id_here

# Optional admin seed defaults
ADMIN_NAME=Platform Admin
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=admin12345
