generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SELLER
  ADMIN
  DISPATCHER
  DRIVER
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  PAID
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String   @id @default(uuid())
  name             String
  phone            String?  @unique
  password         String?
  telegramId       String?  @unique
  telegramUsername String?
  telegramPhoto    String?
  languageCode     String?
  role             Role     @default(USER)
  createdAt        DateTime @default(now())

  authSessions     AuthSession[]
  orders           Order[]
  driverOrders     Order[]              @relation("DriverOrders")
  seller           Seller?
  reviews          Review[]
  assignments      DeliveryAssignment[] @relation("DriverAssignments")
  dispatched       DeliveryAssignment[] @relation("DispatcherAssignments")
  driverProfile    DriverProfile?
  locationHistory  LocationHistory[]
  fraudEvents      FraudEvent[]
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  tokenId          String   @unique
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Seller {
  id            String  @id @default(uuid())
  articleNumber Int     @unique @default(autoincrement())
  userId        String  @unique
  company       String
  verified      Boolean @default(false)

  deletionRequests DeletionRequest[]
  products         Product[]
  user             User              @relation(fields: [userId], references: [id])
}

model Category {
  id            String   @id @default(uuid())
  name          String   @unique
  nameEn        String?
  nameUz        String?
  code          String   @unique
  slug          String?  @unique
  lastSkuNumber Int      @default(0)
  parentId      String?

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]
}

model Product {
  id              String        @id @default(uuid())
  sellerId        String
  name            String
  description     String
  price           Float
  stock           Int
  status          ProductStatus @default(PENDING)
  isVisible       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  imageUrl        String        @default("")
  images          String[]      @default([])
  rejectionReason String?
  categoryId      String?
  brandId         String?
  sku             String?       @unique
  slug            String?       @unique
  articleNumber   Int           @unique @default(autoincrement())

  brand            Brand?            @relation(fields: [brandId], references: [id])
  category         Category?         @relation(fields: [categoryId], references: [id])
  deletionRequests DeletionRequest[]
  moderationLogs   ModerationLog[]
  orderItems       OrderItem[]
  reviews          Review[]
  rating           Float             @default(0)
  reviewsCount     Int               @default(0)
  seller           Seller            @relation(fields: [sellerId], references: [id])
  specifications   Json?

  @@index([status])
  @@index([sellerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status, createdAt])
  @@index([status, price])
}

model ModerationLog {
  id        String   @id @default(uuid())
  adminId   String
  productId String
  action    String
  reason    String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DeletionRequest {
  id        String                @id @default(uuid())
  productId String
  sellerId  String
  reason    String
  status    DeletionRequestStatus @default(PENDING)
  createdAt DateTime              @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller  Seller  @relation(fields: [sellerId], references: [id])
}

model Order {
  id              String        @id @default(uuid())
  userId          String?
  driverId        String?
  total           Float
  status          OrderStatus   @default(NEW)
  createdAt       DateTime      @default(now())
  comment         String?
  customerName    String
  customerPhone   String
  deliveryAddress String?
  deliveryType    DeliveryType  @default(DELIVERY)
  paymentMethod   PaymentMethod @default(CASH)

  items      OrderItem[]
  user       User?               @relation(fields: [userId], references: [id])
  driver     User?               @relation("DriverOrders", fields: [driverId], references: [id])
  assignment DeliveryAssignment?

  @@index([status])
  @@index([userId])
  @@index([driverId])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  quantity  Int
  price     Float
  productId String

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int
  pros      String?
  cons      String?
  comment   String?
  images    String[] @default([])
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  logoUrl     String   @default("")
  website     String?
  description String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  products    Product[]
}

// ─── Delivery / Tracking ──────────────────────────────────────────────────────

enum AssignmentStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum DriverStatus {
  OFFLINE
  ONLINE
  ON_DELIVERY
}

model DriverProfile {
  id        String       @id @default(uuid())
  userId    String       @unique
  status    DriverStatus @default(OFFLINE)
  /// Last known location — updated via Redis; persisted here on status change
  lastLat   Float?
  lastLng   Float?
  lastSeenAt DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryAssignment {
  id           String           @id @default(uuid())
  orderId      String           @unique
  driverId     String
  dispatcherId String
  status       AssignmentStatus @default(PENDING)
  note         String?
  /// Set to true once OTP is verified at delivery
  otpVerified  Boolean          @default(false)
  /// Path to proof-of-delivery photo (if captured)
  podPhotoUrl  String?
  /// GPS coordinates at time of photo upload — for dispute resolution
  podPhotoLat  Float?
  podPhotoLng  Float?
  /// Server-side timestamp of photo upload (not device time — avoids clock skew)
  podPhotoAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  order      Order @relation(fields: [orderId], references: [id])
  driver     User  @relation("DriverAssignments", fields: [driverId], references: [id])
  dispatcher User  @relation("DispatcherAssignments", fields: [dispatcherId], references: [id])

  @@index([driverId])
  @@index([dispatcherId])
  @@index([status])
  @@index([createdAt])
}

/// Batched GPS location history — written every 30s for route replay
model LocationHistory {
  id        String   @id @default(uuid())
  driverId  String
  lat       Float
  lng       Float
  heading   Float?
  speed     Float?
  accuracy  Float?
  createdAt DateTime @default(now())

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
}

/// Fraud / suspicious behaviour log
model FraudEvent {
  id        String   @id @default(uuid())
  driverId  String
  reason    String
  createdAt DateTime @default(now())

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}
