{
  email support@birga-quramiz.uz
}

(site_security) {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    X-XSS-Protection "1; mode=block"
    -Server
  }
}

# Redirect www → main domain
www.birga-quramiz.uz {
  redir https://birga-quramiz.uz{uri} permanent
}

# Main website
birga-quramiz.uz {
  import site_security

  reverse_proxy frontend:3000 {
    health_uri /
    health_interval 10s
    health_timeout 5s
  }
}

# Internal panels — all served by the same Next.js frontend
# proxy.ts handles subdomain → path routing internally
admin.birga-quramiz.uz {
  import site_security

  reverse_proxy frontend:3000 {
    health_uri /
    health_interval 10s
    health_timeout 5s
  }
}

seller.birga-quramiz.uz {
  import site_security

  reverse_proxy frontend:3000 {
    health_uri /
    health_interval 10s
    health_timeout 5s
  }
}

dispatcher.birga-quramiz.uz {
  import site_security

  reverse_proxy frontend:3000 {
    health_uri /
    health_interval 10s
    health_timeout 5s
  }
}

# AI Service
ai.birga-quramiz.uz {
  import site_security

  reverse_proxy ai:8000 {
    health_uri /health
    health_interval 10s
    health_timeout 5s
  }
}

# API
api.birga-quramiz.uz {
  import site_security

  # Static uploads — cache aggressively since filenames are unique timestamps
  handle /uploads/* {
    header Cache-Control "public, max-age=31536000, immutable"
    reverse_proxy backend:5000
  }

  handle {
    reverse_proxy backend:5000 {
      health_uri /health
      health_interval 10s
      health_timeout 5s
    }
  }
}